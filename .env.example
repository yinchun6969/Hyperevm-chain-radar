# HyperEVM Chain Radar V0.3.0
LANGUAGE=zh_CN
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_RPC_URLS=
RPC_FAILBACK_SEC=300
HYPERCORE_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERCORE_INFO_URL=https://api.hyperliquid.xyz/info
HYPERCORE_INFO_TIMEOUT=8

# Realtime scan
POLL_SECONDS=1
START_BACKFILL_BLOCKS=20
ALERT_USD=250000

# HyperCore public smart-money stream
# HYPE spot is @107 on HyperCore mainnet. More coins may be comma-separated.
HYPERCORE_TRADE_COINS=@107
HYPERCORE_SMART_MONEY_MIN_USD=100000
HYPERCORE_WHALE_TRADE_USD=500000

# V0.3 Wallet 360 snapshots
# Only high-scoring wallets are queried to stay well below HyperCore weighted API limits.
WALLET360_MIN_SCORE=60
WALLET360_MAX_WALLETS=12
WALLET360_REFRESH_SEC=60
WALLET360_VAULT_REFRESH_SEC=300
# Alert only on a large change in observed perp notional exposure. Set 0 to disable.
WALLET360_STATE_ALERT_USD=1000000

# V0.3 dynamic user WebSocket subscriptions
SMART_WALLET_STREAM_MIN_SCORE=70
SMART_WALLET_STREAM_MAX_WALLETS=8
# The live socket updates subscribe/unsubscribe without scheduled reconnects.
SMART_WALLET_STREAM_REBUILD_SEC=300
SMART_WALLET_FILL_ALERT_USD=250000
# On an unexpected reconnect, accept only this small overlap from snapshot data;
# storage dedupe (including fill tid) prevents duplicate events/alerts.
SMART_WALLET_SNAPSHOT_RECOVERY_SEC=5

# HyperEVM read-precompile verification
# Keep this small: the same RPC is also serving the realtime EVM scanner.
READ_PRECOMPILE_MAX_WALLETS=3
READ_PRECOMPILE_REFRESH_SEC=300

# Historical HyperSwap V3 pool bootstrap
# Recommended: Etherscan API V2 key for full indexed history on chainid=999.
ETHERSCAN_API_KEY=
ETHERSCAN_LOG_OFFSET=1000
# Without a key, bootstrap recent blocks over RPC in <=50-block queries.
HYPERSWAP_RPC_BOOTSTRAP_BLOCKS=5000
HYPERSWAP_RPC_BOOTSTRAP_SLEEP_SEC=0.7
POOL_BOOTSTRAP_REFRESH_SEC=21600

# Core → EVM → BUY → LP correlation
CAPITAL_SEQUENCE_WINDOW_MIN=180
CAPITAL_SEQUENCE_P1_USD=100000
CAPITAL_SEQUENCE_P0_TRANSFER_USD=500000
CAPITAL_SEQUENCE_P0_BUY_USD=250000
CAPITAL_SEQUENCE_P0_LP_USD=250000

# LP withdrawal radar
LP_RUG_ABSOLUTE_USD=1000000
LP_RUG_P0_DRAIN_PCT=50
LP_RUG_P1_DRAIN_PCT=30
LP_RUG_BASELINE_MIN_USD=500000
LP_RUG_COOLDOWN_MIN=15

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788
LOG_LEVEL=INFO
# DB_PATH=/opt/hyperevm-chain-radar/radar.db
